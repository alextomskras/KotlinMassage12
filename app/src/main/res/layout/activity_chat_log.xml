<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    tools:context=".messages.ChatLogActivity">

    <!-- ===== Нижняя панель ввода (Material 3, стиль мессенджера) ===== -->

    <!-- Кнопка выбора картинки: иконка вместо текста "img".
         Поверх неё лежит select_photoview_image_send — превью выбранного фото. -->
    <ImageButton
        android:id="@+id/image_send_button_chat_log"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/attach_image"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_attach_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Превью выбранного фото: поверх кнопки, виден только при выборе -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/select_photoview_image_send"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:civ_border_color="@color/send_button_background"
        app:civ_border_width="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ===== Пункт 13: панель цитаты (свайп вправо по строке = «Ответить») ===== -->
    <LinearLayout
        android:id="@+id/reply_preview_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/reply_quote_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/reply_preview_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/reply_preview_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/reply_quote_text"
            android:textSize="13sp"
            tools:text="Ответ на: Привет, как дела?" />

        <ImageButton
            android:id="@+id/reply_cancel_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel_reply"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/reply_quote_text" />
    </LinearLayout>

    <EditText
        android:id="@+id/edittext_chat_log"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/input_pill_background"
        android:ems="10"
        android:gravity="center_vertical"
        android:hint="@string/enter_message"
        android:imeOptions="actionSend"
        android:inputType="textShortMessage|textAutoCorrect|textCapSentences"
        android:maxLines="4"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/md_on_surface"
        android:textColorHint="#9AA0A6"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/send_button_chat_log"
        app:layout_constraintStart_toEndOf="@+id/image_send_button_chat_log" />

    <!-- Круглая FAB-кнопка отправки со стрелкой вместо текстовой "Send" -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/send_button_chat_log"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/send"
        app:backgroundTint="@color/send_button_background"
        app:elevation="2dp"
        app:maxImageSize="24dp"
        app:srcCompat="@drawable/ic_send"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_chat_log"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:background="@color/chat_background"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/reply_preview_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>