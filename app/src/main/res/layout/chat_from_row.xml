<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <!-- Пункт 13: плашка «Ответ на: ...» (swipe reply), скрыта без цитаты -->
    <TextView
        android:id="@+id/textview_reply_quote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/reply_quote_background"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/reply_quote_text"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/textview_from_row"
        app:layout_constraintStart_toStartOf="@+id/textview_from_row"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Ответ на: привет, как дела"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textview_from_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        android:text="This is my message that will wrap into multiple lines and keep on going"
        android:maxWidth="240dp"
        android:background="@drawable/bubble_tail_left"
        android:textColor="@color/bubble_in_text"
        android:padding="16dp"
        app:layout_constraintStart_toEndOf="@+id/imageview_chat_from_row"
        app:layout_constraintTop_toBottomOf="@+id/textview_reply_quote" />

    <!-- Статус доставки/прочтения: одна серая галочка = отправлено,
         две синие = прочтено собеседником (см. ChatLogActivity.readTracker). -->
    <ImageView
        android:id="@+id/imageview_msg_status"
        android:layout_width="18dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_check_single"
        android:contentDescription="@null"
        app:tint="@color/tick_sent"
        app:layout_constraintBottom_toBottomOf="@+id/textView_chat_from_message_time2"
        app:layout_constraintTop_toTopOf="@+id/textView_chat_from_message_time2"
        app:layout_constraintEnd_toStartOf="@+id/textView_chat_from_message_time2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/textview_from_row" />

    <TextView
        android:id="@+id/textView_chat_from_message_time2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="2.10.2018"
        android:textColor="@color/time_text"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/textview_from_row"
        app:layout_constraintStart_toEndOf="@+id/imageview_msg_status"
        app:layout_constraintTop_toBottomOf="@+id/textview_from_row"
        app:layout_goneMarginEnd="8dp" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imageview_chat_from_row"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:civ_border_width="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textview_reply_quote"
        app:srcCompat="@android:drawable/btn_star_big_on" />

</androidx.constraintlayout.widget.ConstraintLayout>