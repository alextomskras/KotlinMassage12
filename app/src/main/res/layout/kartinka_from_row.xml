<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <ImageView
        android:id="@+id/kartinka_chat_from_row2"
        android:layout_width="150dp"
        android:layout_height="146dp"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageview_chat_from_row2"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/bubble_image_card" />

    <ImageView
        android:id="@+id/imageview_msg_status_img"
        android:layout_width="18dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_check_single"
        android:contentDescription="@null"
        app:tint="@color/tick_sent"
        app:layout_constraintBottom_toBottomOf="@+id/textView_message_time"
        app:layout_constraintTop_toTopOf="@+id/textView_message_time"
        app:layout_constraintEnd_toStartOf="@+id/textView_message_time" />

    <TextView
        android:id="@+id/textView_message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="2.10.2018"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/kartinka_chat_from_row2"
        app:layout_constraintTop_toBottomOf="@+id/kartinka_chat_from_row2"
        app:layout_goneMarginEnd="8dp" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imageview_chat_from_row2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:civ_border_width="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/btn_star_big_on" />


</androidx.constraintlayout.widget.ConstraintLayout>