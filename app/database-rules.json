{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "publicKey": {
          ".read": "auth != null"
        },
        "keyFingerprint": {
          ".read": "auth != null"
        },
        "keyCreatedAt": {
          ".read": "auth != null"
        }
      }
    },
    "user-messages": {
      ".read": false,
      "$myUid": {
        ".read": "auth != null && auth.uid === $myUid",
        ".write": "auth != null && auth.uid === $myUid",
        "$otherUid": {
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "latest-messages": {
      ".read": false,
      "$myUid": {
        ".read": "auth != null && auth.uid === $myUid",
        ".write": "auth != null && auth.uid === $myUid"
      }
    },
    "user-tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "outbox": {
      "$msgId": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.uid === data.child('fromId').val()"
      }
    },
    "transfers": {
      "$msgId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}