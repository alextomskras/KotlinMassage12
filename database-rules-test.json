{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["username"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "user-messages": {
      ".read": "auth != null",
      "$myUid": {
        ".read": "auth != null && auth.uid === $myUid",
        ".write": "auth != null",
        "$otherUid": {
          ".indexOn": ["timestamp"]
        }
      }
    },
    "latest-messages": {
      ".read": "auth != null",
      "$myUid": {
        ".read": "auth != null && auth.uid === $myUid",
        ".write": "auth != null"
      }
    },
    "user-tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "outbox": {
      ".read": "auth != null",
      "$msgId": {
        ".read": "auth != null && (auth.token.admin === true || auth.uid === data.child('fromId').val())",
        ".write": "auth != null"
      }
    }
  }
}
